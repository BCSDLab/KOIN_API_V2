{
  "schemaVersion": 1,
  "service": "koin-api",
  "environment": "stage",
  "mode": "managed",
  "owner": "BCSD KOIN backend",
  "path": "kv/stage/koin-api/runtime",
  "entries": [
    {
      "key": "WEB_AUTH_CSRF_SECRET_KEY",
      "target": "configtree/auth.web.csrf-secret-key",
      "format": "text"
    },
    { "key": "JWT_SECRET_KEY", "target": "configtree/jwt.secret-key", "format": "text" },
    {
      "key": "JWT_ACCESS_TOKEN_EXPIRATION_TIME",
      "target": "configtree/jwt.access-token.expiration-time",
      "format": "text"
    },
    {
      "key": "REDIS_PASSWORD",
      "target": "configtree/spring.data.redis.password",
      "format": "text"
    },
    { "key": "MONGODB_URI", "target": "configtree/spring.data.mongodb.uri", "format": "text" },
    {
      "key": "DATASOURCE_PASSWORD",
      "target": "configtree/spring.datasource.password",
      "format": "text"
    },
    { "key": "AWS_SES_ACCESS_KEY", "target": "configtree/aws.ses.access-key", "format": "text" },
    { "key": "AWS_SES_SECRET_KEY", "target": "configtree/aws.ses.secret-key", "format": "text" },
    {
      "key": "SLACK_KOIN_EVENT_NOTIFY_URL",
      "target": "configtree/slack.koin_event_notify_url",
      "format": "text"
    },
    {
      "key": "SLACK_KOIN_OWNER_EVENT_NOTIFY_URL",
      "target": "configtree/slack.koin_owner_event_notify_url",
      "format": "text"
    },
    {
      "key": "SLACK_KOIN_SHOP_REVIEW_NOTIFY_URL",
      "target": "configtree/slack.koin_shop_review_notify_url",
      "format": "text"
    },
    {
      "key": "SLACK_KOIN_LOST_ITEM_NOTIFY_URL",
      "target": "configtree/slack.koin_lost_item_notify_url",
      "format": "text"
    },
    {
      "key": "SLACK_LOGGING_ERROR_URL",
      "target": "configtree/slack.logging.error",
      "format": "text"
    },
    { "key": "OPEN_API_KEY_PUBLIC", "target": "configtree/OPEN_API_KEY_PUBLIC", "format": "text" },
    { "key": "OPEN_API_KEY_TMONEY", "target": "configtree/OPEN_API_KEY_TMONEY", "format": "text" },
    { "key": "NAVER_ACCESS_KEY", "target": "configtree/naver.accessKey", "format": "text" },
    { "key": "NAVER_SECRET_KEY", "target": "configtree/naver.secretKey", "format": "text" },
    { "key": "ADDRESS_API_KEY", "target": "configtree/address.api.key", "format": "text" },
    {
      "key": "TOSS_PAYMENT_SECRET_KEY",
      "target": "configtree/toss-payment.secret-key",
      "format": "text"
    },
    { "key": "UPSTAGE_API_KEY", "target": "configtree/upstage.api-key", "format": "text" },
    { "key": "FCM_ADMIN_SDK_JSON", "target": "files/koin-firebase-adminsdk.json", "format": "json" }
  ]
}
