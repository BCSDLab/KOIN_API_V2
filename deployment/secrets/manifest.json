{
  "schemaVersion": 2,
  "service": "koin-api",
  "environment": "stage",
  "mode": "managed",
  "owner": "BCSD KOIN backend",
  "entries": [
    {
      "key": "WEB_AUTH_CSRF_SECRET_KEY",
      "target": "configtree/auth.web.csrf-secret-key",
      "format": "text",
      "source": "auth",
      "purpose": "웹 요청 CSRF 검증"
    },
    {
      "key": "JWT_SECRET_KEY",
      "target": "configtree/jwt.secret-key",
      "format": "text",
      "source": "auth",
      "purpose": "JWT 서명 검증"
    },
    {
      "key": "JWT_ACCESS_TOKEN_EXPIRATION_TIME",
      "target": "configtree/jwt.access-token.expiration-time",
      "format": "text",
      "source": "auth",
      "purpose": "JWT 만료 시간"
    },
    {
      "key": "REDIS_PASSWORD",
      "target": "configtree/spring.data.redis.password",
      "format": "text",
      "source": "database",
      "purpose": "Redis 인증"
    },
    {
      "key": "MONGODB_URI",
      "target": "configtree/spring.data.mongodb.uri",
      "format": "text",
      "source": "database",
      "purpose": "MongoDB 접속 문자열"
    },
    {
      "key": "DATASOURCE_PASSWORD",
      "target": "configtree/spring.datasource.password",
      "format": "text",
      "source": "database",
      "purpose": "MySQL 비밀번호"
    },
    {
      "key": "AWS_SES_ACCESS_KEY",
      "target": "configtree/aws.ses.access-key",
      "format": "text",
      "source": "integrations",
      "purpose": "AWS SES ACCESS KEY 연동"
    },
    {
      "key": "AWS_SES_SECRET_KEY",
      "target": "configtree/aws.ses.secret-key",
      "format": "text",
      "source": "integrations",
      "purpose": "AWS SES SECRET KEY 연동"
    },
    {
      "key": "SLACK_KOIN_EVENT_NOTIFY_URL",
      "target": "configtree/slack.koin_event_notify_url",
      "format": "text",
      "source": "integrations",
      "purpose": "SLACK KOIN EVENT NOTIFY URL 연동"
    },
    {
      "key": "SLACK_KOIN_OWNER_EVENT_NOTIFY_URL",
      "target": "configtree/slack.koin_owner_event_notify_url",
      "format": "text",
      "source": "integrations",
      "purpose": "SLACK KOIN OWNER EVENT NOTIFY URL 연동"
    },
    {
      "key": "SLACK_KOIN_SHOP_REVIEW_NOTIFY_URL",
      "target": "configtree/slack.koin_shop_review_notify_url",
      "format": "text",
      "source": "integrations",
      "purpose": "SLACK KOIN SHOP REVIEW NOTIFY URL 연동"
    },
    {
      "key": "SLACK_KOIN_LOST_ITEM_NOTIFY_URL",
      "target": "configtree/slack.koin_lost_item_notify_url",
      "format": "text",
      "source": "integrations",
      "purpose": "SLACK KOIN LOST ITEM NOTIFY URL 연동"
    },
    {
      "key": "SLACK_LOGGING_ERROR_URL",
      "target": "configtree/slack.logging.error",
      "format": "text",
      "source": "integrations",
      "purpose": "SLACK LOGGING ERROR URL 연동"
    },
    {
      "key": "OPEN_API_KEY_PUBLIC",
      "target": "configtree/OPEN_API_KEY_PUBLIC",
      "format": "text",
      "source": "integrations",
      "purpose": "OPEN API KEY PUBLIC 연동"
    },
    {
      "key": "OPEN_API_KEY_TMONEY",
      "target": "configtree/OPEN_API_KEY_TMONEY",
      "format": "text",
      "source": "integrations",
      "purpose": "OPEN API KEY TMONEY 연동"
    },
    {
      "key": "NAVER_ACCESS_KEY",
      "target": "configtree/naver.accessKey",
      "format": "text",
      "source": "integrations",
      "purpose": "NAVER ACCESS KEY 연동"
    },
    {
      "key": "NAVER_SECRET_KEY",
      "target": "configtree/naver.secretKey",
      "format": "text",
      "source": "integrations",
      "purpose": "NAVER SECRET KEY 연동"
    },
    {
      "key": "ADDRESS_API_KEY",
      "target": "configtree/address.api.key",
      "format": "text",
      "source": "integrations",
      "purpose": "ADDRESS API KEY 연동"
    },
    {
      "key": "TOSS_PAYMENT_SECRET_KEY",
      "target": "configtree/toss-payment.secret-key",
      "format": "text",
      "source": "payment",
      "purpose": "Toss 결제 API 인증"
    },
    {
      "key": "UPSTAGE_API_KEY",
      "target": "configtree/upstage.api-key",
      "format": "text",
      "source": "integrations",
      "purpose": "UPSTAGE API KEY 연동"
    },
    {
      "key": "FCM_ADMIN_SDK_JSON",
      "target": "files/koin-firebase-adminsdk.json",
      "format": "json",
      "source": "firebase",
      "purpose": "Firebase Admin 서비스 계정 JSON"
    }
  ],
  "sources": {
    "database": {
      "path": "kv/stage/koin-api/database",
      "purpose": "MySQL·Redis·MongoDB 연결 인증"
    },
    "auth": {
      "path": "kv/stage/koin-api/auth",
      "purpose": "JWT·CSRF·인증 만료 설정"
    },
    "firebase": {
      "path": "kv/stage/koin-api/firebase",
      "purpose": "Firebase Admin SDK 인증"
    },
    "payment": {
      "path": "kv/stage/koin-api/payment",
      "purpose": "Toss 결제 연동"
    },
    "integrations": {
      "path": "kv/stage/koin-api/integrations",
      "purpose": "AWS SES·Slack·외부 API 연동"
    }
  }
}
